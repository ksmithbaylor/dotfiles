#!/usr/bin/env sh

# Displays the market cap of USDC across all chains
#     Requires curl
usdc() {
  page=$(curl --fail --silent --show-error 'https://usdc.cool') || return 1
  billions=$(printf '%s\n' "$page" | sed -n 's/.*property="og:title" content="$\([0-9.]*\)B USDC issued".*/\1/p')

  if [ -z "$billions" ]; then
    printf '%s\n' 'Unable to read the USDC market cap' >&2
    return 1
  fi

  printf '$%.3f billion\n' "$billions"
}

usdc
